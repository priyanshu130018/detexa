# ==============================================================================
# DETEXA PLATFORM — DOCKER DEPLOYMENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# Never commit real secrets or production credentials to source control.
# ==============================================================================

# ── 1. Application & Runtime Settings ────────────────────────────────────────
APP_NAME=Detexa
APP_VERSION=2.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/detexa.log

# ── 2. Security & JWT Settings ───────────────────────────────────────────────
# Generate a strong 256-bit key in production: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 3. Relational Database (Neon Serverless PostgreSQL / Cloud Postgres) ─────
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# If using the optional local postgres profile (`--profile local-db`), use:
# DATABASE_URL=postgresql://detexa_user:detexa_pass@postgres-local:5432/detexa_db
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# ── 4. Redis Real-Time Feature Store & Sliding Window Cache ─────────────────
# Container-to-container DNS URL: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=2.0

# ── 5. Apache Kafka Streaming ────────────────────────────────────────────────
# Container-to-container DNS broker address: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TRANSACTIONS_TOPIC=detexa.transactions.raw
KAFKA_ALERTS_TOPIC=detexa.alerts.high_risk
KAFKA_CONSUMER_GROUP=detexa-fraud-engine-group
KAFKA_CLIENT_ID=detexa-backend-v2
KAFKA_ENABLED=true

# ── 6. Apache Flink Processing ───────────────────────────────────────────────
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_PORT=8081

# ── 7. Fraud Decision Engine Policy Thresholds ───────────────────────────────
DECISION_THRESHOLD_ALLOW=0.40
DECISION_THRESHOLD_CHALLENGE=0.65
DECISION_THRESHOLD_REVIEW=0.85
RULE_MAX_VELOCITY_1M=5
RULE_MAX_VELOCITY_5M=12
RULE_MAX_FAILED_AUTH_5M=3
RULE_MAX_AMOUNT_DEVIATION=4.5
RULE_MAX_AMOUNT_HARD_LIMIT=10000.0
RULE_MAX_GRAPH_SHARED_USERS=3
RULE_MAX_GRAPH_RISK_SCORE=0.65
RULE_ENABLE_DEVICE_CHANGE_CHALLENGE=true
RULE_ENABLE_IP_HOPPING_CHALLENGE=true
RULE_OFF_PEAK_NIGHT_THRESHOLD=500.0

# ── 8. Groq LLM Incident Explanation Layer (Optional) ────────────────────────
# Set your Groq API key to enable AI incident triage explanations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── 9. Frontend Gateway & Client Base URL ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
