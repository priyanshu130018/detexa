# ==============================================================================
# DETEXA PLATFORM — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ── API Backend Connection ───────────────────────────────────────────────────
# Base URL for the FastAPI backend REST API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Application Metadata ─────────────────────────────────────────────────────
VITE_APP_NAME=Detexa
VITE_APP_VERSION=2.0.0

# ── UI & Polling Configuration ───────────────────────────────────────────────
VITE_ENABLE_AUTO_REFRESH=true
VITE_AUTO_REFRESH_INTERVAL_MS=15000
VITE_DEFAULT_PAGE_SIZE=50
