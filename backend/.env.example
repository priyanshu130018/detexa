# ==============================================================================
# DETEXA PLATFORM — BACKEND CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with your environment configuration.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# ── 1. Application & Runtime Settings ────────────────────────────────────────
APP_NAME=Detexa
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/detexa.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ── 2. API Server & Routing ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# ── 3. CORS Configuration ────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# ── 4. Security & JWT Settings ───────────────────────────────────────────────
# Generate a secure 256-bit random key in production: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 5. Relational Database (PostgreSQL / Neon Cloud) ──────────────────────────
# Local PostgreSQL default:
DATABASE_URL=postgresql://detexa_user:detexa_pass@localhost:5432/detexa_db

# Neon Serverless PostgreSQL Placeholder:
# DATABASE_URL=postgresql://user:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/detexa?sslmode=require

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ── 6. Redis In-Memory Cache & Session Store ─────────────────────────────────
# Local Redis default:
REDIS_URL=redis://localhost:6379/0

# Cloud Redis / Upstash with SSL Placeholder:
# REDIS_URL=rediss://default:your-upstash-password@sample-endpoint.upstash.io:6379

REDIS_ENABLED=true
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CACHE_TTL_STATS=30
REDIS_CACHE_TTL_PREDICTIONS=300

# ── 7. Kafka Distributed Event Streaming ─────────────────────────────────────
# Local or Confluent / Upstash Kafka broker endpoint:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Cloud SASL Authentication Placeholder:
# KAFKA_BOOTSTRAP_SERVERS=sample-kafka-broker.cloud.confluent.io:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your_kafka_api_key
# KAFKA_SASL_PASSWORD=your_kafka_api_secret

KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TRANSACTIONS_TOPIC=detexa.transactions.raw
KAFKA_ALERTS_TOPIC=detexa.alerts.high_risk
KAFKA_CONSUMER_GROUP=detexa-fraud-engine-group
KAFKA_CLIENT_ID=detexa-backend-v2
KAFKA_ENABLED=false

# ── 8. Neo4j Graph Database (Fraud Rings & Entity Resolution) ────────────────
# Local Neo4j instance:
NEO4J_URI=bolt://localhost:7687

# Neo4j AuraDB Cloud Placeholder:
# NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_auradb_password

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_placeholder
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=false

# ── 9. Machine Learning & Inference Thresholds ───────────────────────────────
MODEL_PATH=app/ml/saved
CREDIT_MODEL_FILENAME=credit_fraud_pipeline.pkl
BEHAVIOR_MODEL_FILENAME=behavior_pipeline.pkl
FRAUD_THRESHOLD=0.50
HIGH_RISK_THRESHOLD=0.75
BATCH_INFERENCE_MAX_ROWS=5000
SHAP_TOP_K_FEATURES=10

# ── 10. Groq LLM Explanation Layer ──────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
